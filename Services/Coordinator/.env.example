# LetsDeepRock Coordinator - environment template (dev & production).
# Copy to .env for local development; .env is gitignored and never committed.
# Production: copy to /etc/letsdeeprock/coordinator.env (loaded by systemd EnvironmentFile).
# Never commit real secrets.

# HTTP(S) control plane
COORDINATOR_HTTP_ADDR=:8443

# STUN (UDP) listener
COORDINATOR_STUN_ADDR=:3478

# TURN relay support (empty RELAY_SECRET = STUN-only, no allocations).
# RELAY_SECRET: generate with `openssl rand -hex 32`.
# RELAY_ADDR: public address advertised in allocation responses, e.g. the
#   server's public IP or a DDNS hostname (clients must reach this address).
# RELAY_MIN/MAX_PORT: UDP port range for relayed allocations.
RELAY_SECRET=
RELAY_ADDR=
RELAY_MIN_PORT=49152
RELAY_MAX_PORT=65535
RELAY_TTL_SECONDS=3600
RELAY_MAX_ALLOCS_PER_USER=8

# PostgreSQL (localhost only)
DATABASE_URL=postgres://letsdeeprock:letsdeeprock123@127.0.0.1:5432/letsdeeprock

# MinIO / Silo (localhost only)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=checkpoints
MINIO_ACCESS_KEY=letsdeeprock
MINIO_SECRET_KEY=letsdeeprock123

# JWT signing secret: generate with `openssl rand -hex 32`
JWT_SECRET=dev-only-secret-change-me

# TLS (leave empty for plain HTTP in dev; set real paths in production)
TLS_CERT_FILE=
TLS_KEY_FILE=
# Production example:
# TLS_CERT_FILE=/etc/letsdeeprock/tls/fullchain.pem
# TLS_KEY_FILE=/etc/letsdeeprock/tls/privkey.pem
