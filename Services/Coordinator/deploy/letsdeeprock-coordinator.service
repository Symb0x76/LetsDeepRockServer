[Unit]
Description=LetsDeepRock Coordinator (control plane: auth, match, lease, checkpoint)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=letsdeeprock
Group=letsdeeprock
ExecStart=/usr/local/bin/letsdeeprock-coordinator
EnvironmentFile=/etc/letsdeeprock/coordinator.env
WorkingDirectory=/var/lib/letsdeeprock
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/letsdeeprock

[Install]
WantedBy=multi-user.target
