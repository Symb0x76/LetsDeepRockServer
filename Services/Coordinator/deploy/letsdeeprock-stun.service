[Unit]
Description=LetsDeepRock STUN server (RFC 5389 Binding, UDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=letsdeeprock
Group=letsdeeprock
ExecStart=/usr/local/bin/letsdeeprock-coordinator -stun
EnvironmentFile=/etc/letsdeeprock/coordinator.env
Restart=on-failure
RestartSec=5

# STUN runs as a separate binary mode of the same build; the listener is
# UDP-only, no filesystem writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
